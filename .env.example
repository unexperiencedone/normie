# ---- PostgreSQL cluster (a superuser; used to provision one database per project) ----
# The path is the control-plane database name (created automatically).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/control
# Or, if you run ./scripts/dev-db.sh (project-local cluster on :5433), leave DATABASE_URL empty and set:
# PG_HOST=localhost
# PG_PORT=5433
# PG_ADMIN_USER=dbforge_admin
# DBFORGE_ADMIN_PASSWORD=...

# ---- Secrets (./scripts/bootstrap.sh generates these) ----
JWT_SECRET=
CREDENTIALS_KEY=          # Fernet key: encrypts tenant DB passwords at rest

# ---- LLM: any OpenAI-compatible endpoint ----
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_API_KEY=
AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ---- Guardrails ----
STATEMENT_TIMEOUT_MS=5000
ROW_LIMIT=1000
