# Copy to .env.docker (next to docker-compose.yml) and fill in. Never commit the filled-in copy.
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"                          # JWT_SECRET, POSTGRES_PASSWORD
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())" # CREDENTIALS_KEY

# PostgreSQL superuser password (inside the stack only)
POSTGRES_PASSWORD=

# App secrets
JWT_SECRET=
CREDENTIALS_KEY=

# LLM (NVIDIA NIM or any OpenAI-compatible endpoint)
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_API_KEY=
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Local test (laptop): leave as is, open http://localhost
DOMAIN=:80
SITE_URL=http://localhost
COOKIE_SECURE=false
PUBLIC_DB_HOST=localhost
DB_PORT=5432                # use e.g. 5434 if this machine already runs PostgreSQL on 5432

# --- On a server with a domain pointing at it, use instead:
# DOMAIN=normie.example.com
# SITE_URL=https://normie.example.com
# COOKIE_SECURE=true
# PUBLIC_DB_HOST=normie.example.com
# DB_PUBLISH=0.0.0.0        # only if users should reach their databases with psql from outside
